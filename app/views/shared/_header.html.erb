<header>
  <div class="header-bar">
    <%= link_to root_path, class: "app-brand" do %>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4h10l6 6v10H4z" />
        <path d="M14 4v6h6" />
        <path d="M8 15l2 2 4-4" />
      </svg>
      <span>
        <span class="app-brand-title"><%= t("app_name") %></span>
        <span class="app-brand-department"><%= t("app_department") %></span>
      </span>
    <% end %>
    <% operator = operator_switch %>
    <div role="group" aria-label="<%= t("operators.switch_label") %>" class="role-navigation">
      <%= form_with url: operator_path, method: :patch, class: "role-form" do %>
        <%= hidden_field_tag :user_id, "", id: nil %>
        <%= button_tag t("navigation.roles.admin"), type: "submit",
                       class: "role-link #{'role-link-active' unless operator[:staff]}",
                       aria: { pressed: !operator[:staff] } %>
      <% end %>
      <% operator[:candidates].each do |candidate| %>
        <% selected = operator[:staff] && candidate.id == operator[:selected_id] %>
        <%= form_with url: operator_path, method: :patch, class: "role-form" do %>
          <%= hidden_field_tag :user_id, candidate.id, id: nil %>
          <%= button_tag candidate.name, type: "submit", class: "role-link #{'role-link-active' if selected}",
                         aria: { pressed: selected } %>
        <% end %>
      <% end %>
    </div>
  </div>
  <%= render "shared/tabs", skill_map_count: local_assigns[:skill_map_count],
                            training_count: local_assigns[:training_count],
                            unread_count: local_assigns[:unread_count] %>
  <div class="app-container pt-6">
    <%= render "shared/skill_legend", admin: admin_page? %>
    <%= render "shared/flash" %>
  </div>
</header>
