<%# skill_map_count: スキルマップ（できる人が1人以下の作業）、training_count: 未完了の教える・教わる予定、unread_count: 改訂後未確認。0件・省略・nil のときはバッジを出さない %>
<% counts = {
     admin_skill_map_path => local_assigns[:skill_map_count],
     staff_skills_path => local_assigns[:training_count],
     staff_manual_revisions_path => local_assigns[:unread_count]
   } %>
<nav aria-label="画面切り替え" class="page-navigation">
  <% navigation_items.each do |label, path| %>
    <%= link_to path,
                class: navigation_current?(path) ? "page-tab page-tab-active" : "page-tab",
                aria: { current: navigation_current?(path) ? "page" : nil } do %>
      <span><%= label %></span>
      <% count = counts[path] %>
      <% if count.to_i.positive? %>
        <span class="notification-count"><%= count %></span>
      <% end %>
    <% end %>
  <% end %>
</nav>
