<section class="operation-staff-status" aria-labelledby="operation-staff-status-title">
  <h2 id="operation-staff-status-title" class="operation-staff-status-title"><%= t("operations.staff_status.title") %></h2>
  <% if rows.empty? %>
    <p class="operation-empty"><%= t("operations.staff_status.empty") %></p>
  <% else %>
    <div class="operation-staff-status-scroll">
      <ul class="operation-staff-status-list">
        <% rows.each do |row| %>
          <li class="operation-staff-status-row">
            <span class="operation-staff-status-person">
              <%= row.user.name %>
            </span>
            <span class="operation-staff-status-level">
              <span class="skill-level skill-level-<%= row.skill.level %>"><span class="sr-only"><%= t("operations.level_prefix") %></span><%= row.skill.level %></span>
              <span class="operation-staff-status-level-name"><%= t("skill_levels.#{row.skill.level}") %></span>
            </span>
            <%# 確認状況と研修の文は、スキルマップのマスの詳細と同じヘルパー（SkillsHelper）で出す %>
            <span class="operation-staff-status-details">
              <span class="operation-badge operation-badge-neutral"><%= skill_manual_status_label(row.skill) %></span>
              <span><%= t("operations.staff_status.training", status: skill_training_label(row.skill)) %></span>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>
