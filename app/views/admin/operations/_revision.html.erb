<div class="operation-revision">
  <% if @editing_manual %>
    <% if @revision_error %>
      <p class="operation-revision-error" role="alert"><%= @revision_error %></p>
    <% end %>
    <%= form_with url: admin_operation_manual_path(operation), method: :patch, scope: :manual, class: "operation-revision-form" do |form| %>
      <%= form.hidden_field :version, value: @revision_version %>
      <%= form.label :body, t("operations.revision_body") %>
      <%= form.text_area :body, value: @revision_body, rows: 7, required: true, class: "operation-revision-field" %>
      <%= form.label :memo, t("operations.revision_memo") %>
      <%= form.text_field :memo, value: @revision_memo, placeholder: t("operations.revision_memo_example"), class: "operation-revision-field" %>
      <div class="operation-revision-actions">
        <%= form.submit t("operations.revision_save"), class: "btn btn-primary" %>
        <%= link_to t("operations.revision_cancel"), admin_operations_path(operation_id: operation.id), class: "btn" %>
      </div>
    <% end %>
  <% else %>
    <div class="operation-revision-actions">
      <%= link_to t("operations.revision_edit"), edit_admin_operation_manual_path(operation), class: "btn btn-primary" %>
      <p class="operation-revision-hint"><%= t("operations.revision_hint") %></p>
    </div>
  <% end %>
</div>
