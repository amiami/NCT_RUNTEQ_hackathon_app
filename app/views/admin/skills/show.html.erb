<% content_for :title, "#{t('page_titles.admin', page: t('navigation.admin.skill_map'))} | #{t('app_name')}" %>
<%# スキルマップのマスの詳細。スキルマップのマスを押すと、この turbo_frame_tag の中身が表の上の枠に入る。
    管理者の見立ては、今のレベルで意味のない値（4▲・4▽・3◇）も実際の値で出し、説明を添える %>
<%= turbo_frame_tag "skill_detail" do %>
  <section class="card skill-detail">
    <div class="skill-detail-header">
      <h2 class="skill-detail-title"><%= t(".title", user: @skill.user.name, operation: @skill.operation.name) %></h2>
      <%# 今のレベル。数字の色と名前は凡例・マスと同じ（見立ての説明や選べる見立てがレベルで決まるため） %>
      <p class="skill-detail-level">
        <span class="skill-level skill-level-<%= @skill.level %>"><%= @skill.level %></span>
        <span><%= t("skill_levels.#{@skill.level}") %></span>
      </p>
    </div>
    <dl class="skill-detail-items">
      <div>
        <dt><%= t(".manual_status") %></dt>
        <dd class="skill-detail-manual-status"><%= t(".manual_statuses.#{@skill.manual_status}") %></dd>
      </div>
      <div>
        <dt><%= t(".training") %></dt>
        <dd class="skill-detail-training">
          <% if (training = @skill.latest_done_training) %>
            <%= t(".trainings.done", trainer: training.trainer.admin? ? training.trainer.name : t(".staff_name", name: training.trainer.name), date: l(training.done_on)) %>
          <% else %>
            <%= t(".trainings.#{@skill.training_status}") %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt><%= t(".admin_assessment") %></dt>
        <dd class="skill-detail-assessment">
          <%# 今の値を選んだ状態で出す。選び直しても保存はせず、skill-map コントローラの下書きに入る（「変更を保存」でまとめて保存）。
              選べるのは、なし・今のレベルで付けられる見立て（Skills::AssessmentUpdate::ASSIGNABLE_LEVELS）・今の値（選び直すと下書きの取り消し）。
              ▽は「教え終わった」でしか付かないので、今の値が▽のときだけ出す %>
          <% current = @skill.admin_assessment.to_s %>
          <% choices = [ "", "can_train", "needs_training", ("training_done" if current == "training_done"), "backup_trainer" ].compact %>
          <fieldset class="assessment-choices" data-skill-map-target="assessment"
                    data-skill-id="<%= @skill.id %>" data-original-assessment="<%= current %>">
            <legend class="sr-only"><%= t(".admin_assessment") %></legend>
            <% choices.each do |value| %>
              <% selectable = value.empty? || value == current || Skills::AssessmentUpdate::ASSIGNABLE_LEVELS[value] == @skill.level %>
              <label class="assessment-choice">
                <%= radio_button_tag "admin_assessment", value, value == current, disabled: !selectable,
                                     data: { action: "skill-map#chooseAssessment" } %>
                <span><%= value.empty? ? t(".no_assessment") : "#{t("admin_assessments.#{value}.mark")} #{t("admin_assessments.#{value}.label")}" %></span>
              </label>
            <% end %>
          </fieldset>
          <% note = t(".hidden_assessment_notes.level_#{@skill.level}.#{current}", default: "") if @skill.admin_assessment %>
          <% if note.present? %>
            <p class="skill-detail-assessment-note"><%= note %></p>
          <% end %>
        </dd>
      </div>
    </dl>
  </section>
<% end %>
