<%# 研修画面のカード1枚（作業1つ）。TrainingBoard::Card を受け取る。ボタンの動き（下書き）は #61 で付ける %>
<% operation = card.operation %>
<section class="card training-card <%= "training-card-caution" if card.capable_count <= 1 %>" aria-labelledby="training-card-<%= operation.id %>"
         data-training-filter-target="card" data-status="<%= card.status %>"
         data-needs-instruction="<%= card.needs_instruction? %>">
  <h2 id="training-card-<%= operation.id %>" class="training-card-title">
    <span><%= operation.name %></span>
    <% if card.capable_count <= 1 %>
      <span class="badge badge-warning capable-warning"><%= t(".capable_count", count: card.capable_count) %></span>
    <% end %>
  </h2>

  <div class="training-card-grid">
    <div class="training-column">
      <p class="training-column-label"><%= t(".columns.due_on") %></p>
      <%= tag.input type: "date", value: card.due_on&.iso8601,
                    class: [ "date-field", ("due-soon" if due_soon?(card.due_on)) ],
                    aria: { label: t(".due_label", name: operation.name) } %>
      <% if operation.season_note.present? %>
        <p class="season-note"><%= operation.season_note %></p>
      <% end %>
    </div>

    <div class="training-column">
      <p class="training-column-label"><%= t(".columns.trainers") %></p>
      <div class="chip-list">
        <% card.trainer_skills.each do |skill| %>
          <button type="button" class="trainer-chip">
            <span class="skill-level skill-level-<%= skill.level %>"><%= skill.level %></span>
            <span><%= skill.user.name %></span>
            <%= assessment_mark(skill) %>
          </button>
        <% end %>
        <% card.admins.each do |admin| %>
          <button type="button" class="trainer-chip"><span><%= admin.name %></span></button>
        <% end %>
      </div>
    </div>

    <div class="training-column">
      <p class="training-column-label"><%= t(".columns.trainees") %></p>
      <div class="chip-list">
        <% card.trainee_skills.each do |skill| %>
          <button type="button" class="trainee-chip" aria-pressed="false">
            <span class="skill-level skill-level-<%= skill.level %>"><%= skill.level %></span>
            <span><%= skill.user.name %></span>
            <%= assessment_mark(skill) %>
          </button>
        <% end %>
        <% if card.trainee_skills.empty? %>
          <span class="chip-empty"><%= t(".no_trainees") %></span>
        <% end %>
      </div>
    </div>

    <div class="training-column">
      <p class="training-column-label"><%= t(".columns.trainings") %></p>
      <div class="chip-list">
        <% card.trainings.each do |training| %>
          <button type="button" class="plan-chip"
                  aria-label="<%= t(".plan_label", trainer: training.trainer.name, trainee: training.trainee.name) %>">
            <span class="plan-chip-names"><%= training.trainer.name %> → <%= training.trainee.name %></span>
            <span class="plan-chip-due"><%= training_due_label(training.due_on) %></span>
          </button>
        <% end %>
        <% if card.trainings.empty? %>
          <span class="chip-empty"><%= t(".no_trainings") %></span>
        <% end %>
      </div>
    </div>
  </div>
</section>
